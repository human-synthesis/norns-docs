{
  "name": "norns-docs",
  "version": "0.0.1",
  "description": "Documentation site for the Norns platform — norns-docs.humansynthesis.ai. A Norns app; the docs feature folder is the seed of the future CMS.",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "bun scripts/gen-reference.mjs",
    "dev": "bun scripts/gen-reference.mjs && NODE_OPTIONS='--preserve-symlinks' norns dev",
    "build": "bun scripts/gen-reference.mjs && NODE_OPTIONS='--preserve-symlinks' norns build",
    "preview": "norns preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "norns check",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "lint": "norns lint",
    "deploy": "bun run build && wrangler deploy"
  },
  "devDependencies": {
    "@human-synthesis/norns": "^0.0.20",
    "@human-synthesis/norns-core": "^0.0.12",
    "@human-synthesis/norns-ui": "^0.0.15",
    "@cloudflare/workers-types": "^4",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4",
    "vite": "^8.0.12",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "marked": "^15.0.0",
    "shiki": "^1.29.0"
  },
  "packageManager": "bun@1.3.14"
}
